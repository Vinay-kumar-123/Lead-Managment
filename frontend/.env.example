# KONNEVIA Frontend Environment Variables
# Copy to .env for local development. Never commit sensitive keys to source control.

# Base REST API URL of the Express backend
VITE_API_BASE_URL=http://localhost:8001/api/v1

# Google Identity Services OAuth 2.0 Client ID for Provider Sign-In
VITE_GOOGLE_CLIENT_ID=

# In Production (e.g. Render/Vercel):
# VITE_API_BASE_URL=https://konnevia-backend.onrender.com/api/v1
